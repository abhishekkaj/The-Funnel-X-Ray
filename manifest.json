{
  "manifest_version": 3,
  "name": "The Funnel X-Ray",
  "version": "3.0.0",
  "description": "One-click digital marketing strategy diagnostic tool.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": [
    "https://api.gumroad.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open The Funnel X-Ray"
  }
}